#!/bin/bash
set -euo pipefail

usage() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Starts the PowerFixer API server."
    echo ""
    echo "Options:"
    echo "  --port PORT          Port for callback API (default: 3001)"
    echo "  --ngrok              Start ngrok tunnel for external access"
    echo "  --log-level LEVEL    error|warn|info|debug|trace (default: info)"
    echo "  --clear-db           Clear the database before starting"
    echo "  --slack              Enable Slack notifications with local marker"
    echo "  --help               Show this help message"
    echo ""
    echo "Optional GCP environment variables:"
    echo "  POWERFIXER_GCP_PROJECT            GCP project for Secret Manager lookups"
    echo "  POWERFIXER_WARP_API_KEY_SECRET    Secret name for WARP_API_KEY"
    echo "  POWERFIXER_SLACK_BOT_TOKEN_SECRET Secret name for SLACK_BOT_TOKEN"
    echo "  POWERFIXER_OPENAI_API_KEY_SECRET  Secret name for OPENAI_API_KEY"
    echo "  POWERFIXER_GITHUB_TOKEN_SECRET    Secret name for GITHUB_TOKEN"
}

CALLBACK_PORT="${POWERFIXER_CALLBACK_PORT:-3001}"
USE_NGROK=false
CLEAR_DB=false
LOG_LEVEL="info"
SLACK_MODE="disabled"

while [[ $# -gt 0 ]]; do
    case $1 in
        --port) CALLBACK_PORT="$2"; shift 2 ;;
        --ngrok) USE_NGROK=true; shift ;;
        --log-level) LOG_LEVEL="$2"; shift 2 ;;
        --clear-db) CLEAR_DB=true; shift ;;
        --slack) SLACK_MODE="local"; shift ;;
        --help) usage; exit 0 ;;
        *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
done

NGROK_PID=""
cleanup() {
    if [ -n "$NGROK_PID" ]; then
        kill "$NGROK_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

start_ngrok() {
    if [ -z "${NGROK_DOMAIN:-}" ]; then
        echo "Warning: NGROK_DOMAIN not set, skipping ngrok"
        return
    fi
    pkill -9 ngrok 2>/dev/null || true
    sleep 1
    ngrok http "$CALLBACK_PORT" --domain="$NGROK_DOMAIN" --log=stdout >/tmp/ngrok.log 2>&1 &
    NGROK_PID=$!
    sleep 2
    if ! kill -0 "$NGROK_PID" 2>/dev/null; then
        echo "Error: ngrok failed to start"
        cat /tmp/ngrok.log
        exit 1
    fi
}

if [ -f .env ]; then
    export $(grep -v '^#' .env | xargs)
fi

GCP_PROJECT="${POWERFIXER_GCP_PROJECT:-}"
WARP_API_KEY_SECRET="${POWERFIXER_WARP_API_KEY_SECRET:-powerfixer-warp-api-key}"
SLACK_BOT_TOKEN_SECRET="${POWERFIXER_SLACK_BOT_TOKEN_SECRET:-powerfixer-slack-bot-token}"
OPENAI_API_KEY_SECRET="${POWERFIXER_OPENAI_API_KEY_SECRET:-openai-secret}"
GITHUB_TOKEN_SECRET="${POWERFIXER_GITHUB_TOKEN_SECRET:-powerfixer-github-token}"

load_secret_if_unset() {
    local var_name="$1"
    local secret_name="$2"
    local current_value="${!var_name:-}"

    if [ -n "$current_value" ] || [ -z "$GCP_PROJECT" ] || ! command -v gcloud >/dev/null 2>&1; then
        return
    fi

    local fetched_value
    fetched_value="$(gcloud secrets versions access latest --secret="$secret_name" --project="$GCP_PROJECT" 2>/dev/null || true)"
    if [ -n "$fetched_value" ]; then
        export "$var_name=$fetched_value"
        echo "Loaded $var_name from Secret Manager ($secret_name)."
    fi
}

load_secret_if_unset "WARP_API_KEY" "$WARP_API_KEY_SECRET"
load_secret_if_unset "SLACK_BOT_TOKEN" "$SLACK_BOT_TOKEN_SECRET"
load_secret_if_unset "OPENAI_API_KEY" "$OPENAI_API_KEY_SECRET"
load_secret_if_unset "GITHUB_TOKEN" "$GITHUB_TOKEN_SECRET"

if [ -z "${DATABASE_URL:-}" ]; then
    echo "Error: DATABASE_URL not set"
    echo "Set DATABASE_URL in your environment or .env before running this script."
    exit 1
fi

if [ "$CLEAR_DB" = true ]; then
    psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"
fi

echo "Building Power Fixer Server..."
cargo build --release

if [ "$USE_NGROK" = true ]; then
    start_ngrok
fi

export RUST_LOG="$LOG_LEVEL"
export SLACK_MODE="$SLACK_MODE"
echo "Starting PowerFixer API server..."
exec ./target/release/power-fixer-server --port "$CALLBACK_PORT" --log-level "$LOG_LEVEL"
