# Required
DATABASE_URL=postgres://postgres@localhost/powerfixer

# Agent runtime API
WARP_API_KEY=your_agent_platform_api_key
# WARP_API_BASE_URL=https://warp.dev/api/v1

# Optional GCP Secret Manager fallback (used when WARP_API_KEY is unset)
# POWERFIXER_GCP_PROJECT=your-gcp-project
# POWERFIXER_WARP_API_KEY_SECRET=powerfixer-warp-api-key
# POWERFIXER_SLACK_BOT_TOKEN_SECRET=powerfixer-slack-bot-token
# POWERFIXER_OPENAI_API_KEY_SECRET=openai-secret
# POWERFIXER_GITHUB_TOKEN_SECRET=powerfixer-github-token

# Runtime routing and identity
POWERFIXER_CALLBACK_URL=http://localhost:3001
POWERFIXER_CALLBACK_PORT=3001
POWERFIXER_DEFAULT_GITHUB_ORG=example-org
POWERFIXER_DEFAULT_PROJECT=example-repo

# Agent launch configuration
POWERFIXER_ENVIRONMENT_ID=your-default-environment-id
# POWERFIXER_DEDUPE_ENVIRONMENT_ID=your-dedupe-environment-id
# POWERFIXER_AGENT_PROFILE_ID=your-agent-profile-id
# POWERFIXER_TEAM_SCOPED=false
# POWERFIXER_TRIAGE_SECRET_NAME=POWERFIXER_GH_TOKEN
# POWERFIXER_DEDUPE_SECRET_NAME=POWERFIXER_GH_TOKEN_READONLY

# Optional integrations
# OPENAI_API_KEY=...
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# SLACK_MODE=disabled
# SLACK_BOT_TOKEN=xoxb-...
# POWERFIXER_WEBHOOK_API_KEY=...

# Logging
RUST_LOG=info
